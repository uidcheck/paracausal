<%- include('../../partials/header') %>
<%- include('../../partials/messages') %>
<a href="/admin/videos" class="back-link">&larr; Back to video management</a>
<h2>Add Video</h2>
<form action="/admin/videos" method="post" enctype="multipart/form-data" class="admin-form">
  <%- include('../../partials/csrf-field') %>
  <label>Title: <input type="text" name="title" required></label>
  <label>Slug: <input type="text" name="slug" placeholder="leave blank to generate from title"></label>
  <p style="font-size:0.8rem;color:#888; margin-top:-0.5rem;">Letters, numbers and hyphens only. Numeric-only slugs are not allowed.</p>
  <label>Description:<textarea name="description"></textarea></label>
  <label>Tags: <input type="text" name="tags" placeholder="performance, tutorial, archive"></label>
  <label>Status:
    <select name="publication_status">
      <% publicationStatusOptions.forEach((option) => { %>
        <option value="<%= option.value %>" <%= option.value === 'published' ? 'selected' : '' %>><%= option.label %></option>
      <% }) %>
    </select>
  </label>
  <label>Scheduled Publish Time: <input type="datetime-local" name="published_at"></label>
  <label>Video File: <input type="file" name="file" accept="video/*" required></label>
  <% if (playlists && playlists.length) { %>
    <label>Playlists:
      <select name="playlists" multiple size="4">
        <% playlists.forEach(p => { %>
          <option value="<%= p.id %>"><%= p.title %></option>
        <% }) %>
      </select>
    </label>
    <p style="font-size:0.8rem;color:#888;">(hold Ctrl/Cmd to select multiple)</p>
  <% } %>
  <h3>Connected Content</h3>
  <p style="font-size:0.8rem;color:#888;">Hold Ctrl or Cmd to select multiple items.</p>
  <button type="submit">Save</button>
</form>
<%- include('../../partials/footer') %>