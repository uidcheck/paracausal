<%- include('../../partials/header') %>
<%- include('../../partials/messages') %>
<a href="/admin" class="back-link">&larr; Back to dashboard</a>
<h2>Gallery Collections</h2>

<div class="admin-split-layout">
  <section class="admin-section-card">
    <h3>Create Gallery Collection</h3>
    <form action="/admin/collections/gallery" method="post" class="admin-form">
      <%- include('../../partials/csrf-field') %>
      <label>Title
        <input type="text" name="title" required>
      </label>
      <label>Description
        <textarea name="description" rows="4"></textarea>
      </label>
      <button type="submit">Create Collection</button>
    </form>
  </section>

  <section class="admin-section-card">
    <h3>Existing Collections</h3>
    <% if (collections && collections.length) { %>
      <ul class="admin-list">
        <% collections.forEach((collection) => { %>
          <li>
            <span class="item-title"><strong><%= collection.title %></strong></span>
            <span class="item-meta-text"><%= collection.item_count || 0 %> images</span>
            <% if (collection.description) { %>
              <p class="admin-section-note"><%= collection.description %></p>
            <% } %>
            <div class="admin-item-actions">
              <a href="/admin/collections/gallery/<%= collection.id %>/edit">edit</a> |
              <form action="/admin/collections/gallery/<%= collection.id %>?_method=DELETE" method="post" style="display:inline;">
                <%- include('../../partials/csrf-field') %>
                <button type="submit" class="link-button">delete</button>
              </form>
            </div>
          </li>
        <% }) %>
      </ul>
    <% } else { %>
      <p>No gallery collections yet.</p>
    <% } %>
  </section>
</div>

<p class="admin-section-note" style="margin-top:1rem;">Assign images from the gallery list or the image edit screen.</p>
<%- include('../../partials/footer') %>