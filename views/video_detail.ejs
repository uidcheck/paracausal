<%- include('partials/header') %>
<%- include('partials/messages') %>
<div class="video-detail-page">
  <a href="/videos" class="back-link">&larr; Back to videos</a>

  <h2><%= video.title %></h2>
  <%- include('partials/tag-pills', { tags: video.tags, className: 'tag-pill-row-inline', tagContext: 'videos' }) %>

  <% if (video.filename) { %>
    <div class="video-detail-player-shell" data-video-player tabindex="0">
      <div class="video-detail-player">
        <div class="video-detail-player__stage">
          <video
            id="video-detail"
            class="video-detail-player__media"
            playsinline
            preload="metadata"
            controlslist="nodownload noplaybackrate"
            disablepictureinpicture>
          <source src="/uploads/videos/<%= video.filename %>?t=<%= Date.now() %>" type="video/mp4">
          Your browser does not support the video tag.
          </video>
        </div>
      </div>
      <div class="video-controls video-controls--detail" data-video-id="detail">
        <button type="button" class="play-pause" aria-label="Play video">Play</button>
        <input type="range" class="seek" min="0" max="1000" step="1" value="0" aria-label="Seek video">
        <span class="current-time">0:00</span>
        <span class="video-controls__time-separator">/</span>
        <span class="duration">0:00</span>
        <div class="video-controls__volume-group">
          <button type="button" class="mute-toggle" aria-label="Mute video" data-volume-state="high">
            <span class="video-controls__icon video-controls__icon--volume-high" aria-hidden="true">
              <svg viewBox="0 0 24 24" focusable="false">
                <path d="M14 5v14l-5-4H5V9h4l5-4Z" fill="currentColor"></path>
                <path d="M16.5 8.5a5 5 0 0 1 0 7" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"></path>
                <path d="M18.5 5.5a9 9 0 0 1 0 13" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"></path>
              </svg>
            </span>
            <span class="video-controls__icon video-controls__icon--volume-low" aria-hidden="true">
              <svg viewBox="0 0 24 24" focusable="false">
                <path d="M14 5v14l-5-4H5V9h4l5-4Z" fill="currentColor"></path>
                <path d="M16.5 8.5a5 5 0 0 1 0 7" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"></path>
              </svg>
            </span>
            <span class="video-controls__icon video-controls__icon--volume-muted" aria-hidden="true">
              <svg viewBox="0 0 24 24" focusable="false">
                <path d="M14 5v14l-5-4H5V9h4l5-4Z" fill="currentColor"></path>
                <path d="m17 9 4 4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"></path>
                <path d="m21 9-4 4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"></path>
              </svg>
            </span>
          </button>
          <div class="video-controls__volume-popover">
            <input type="range" class="volume" min="0" max="1" step="0.05" value="1" aria-label="Video volume">
          </div>
        </div>
        <button type="button" class="fullscreen" aria-label="Toggle fullscreen">Fullscreen</button>
      </div>
    </div>
  <% } %>

  <% if (video.description) { %>
    <section class="video-detail-page__description">
      <h3>Description</h3>
      <p><%= video.description %></p>
    </section>
  <% } %>
</div>
<%- include('partials/footer') %>
