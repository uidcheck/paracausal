<%- include('partials/header') %>
<%- include('partials/messages') %>
<h2>Gallery</h2>
<form method="get" class="search-form">
  <input type="text" name="search" value="<%= search || '' %>" placeholder="Search gallery">
  <% if (selectedCollection) { %>
    <input type="hidden" name="collection" value="<%= selectedCollection %>">
  <% } %>
  <button type="submit">Search</button>
</form>
<div class="page-with-sidebar">
  <aside class="playlist-panel">
    <h3>Collections</h3>
    <div class="playlist-item">
      <a href="/gallery" class="playlist-link<%= !selectedCollection ? ' active' : '' %>">All Images</a>
    </div>
    <% if (collections && collections.length) { %>
      <% collections.forEach((collection) => { %>
        <div class="playlist-item">
          <a href="/gallery?collection=<%= collection.id %>" class="playlist-link<%= selectedCollection == collection.id ? ' active' : '' %>">
            <%= collection.title %> (<%= collection.count || 0 %>)
          </a>
        </div>
      <% }) %>
    <% } else { %>
      <p style="font-size:0.85rem; color:#777; margin-top:0.6rem;">No collections yet.</p>
    <% } %>
  </aside>

  <div class="gallery-main">
    <% if (selectedCollectionInfo) { %>
      <section class="collection-info">
        <h3><%= selectedCollectionInfo.title %></h3>
        <% if (selectedCollectionInfo.description) { %>
          <p><%= selectedCollectionInfo.description %></p>
        <% } %>
        <span><%= selectedCollectionInfo.count || 0 %> images</span>
      </section>
    <% } %>

    <% if (images && images.length) { %>
      <div class="gallery-grid">
        <% images.forEach((img, index) => { %>
          <% const imageUrl = getOriginalImageUrl('images', img.filename); %>
          <% const detailHref = img.slug ? ('/gallery/' + encodeURIComponent(img.slug)) : ('/gallery/' + img.id); %>
          <% const captionText = typeof img.caption === 'string' ? img.caption.trim() : ''; %>
          <div class="gallery-item">
            <a href="<%= detailHref %>" class="gallery-item__image-link">
              <% if (imageUrl) { %>
                <img src="<%= imageUrl %>" alt="<%= img.title %>" loading="<%= index < 6 ? 'eager' : 'lazy' %>" decoding="async" width="480" height="480">
              <% } %>
            </a>
            <h3><a href="<%= detailHref %>" class="gallery-item__title-link"><%= img.title %></a></h3>
            <% if (captionText) { %>
              <p><%= captionText %></p>
            <% } %>
            <%- include('partials/tag-pills', { tags: img.tags, className: 'tag-pill-row-compact', tagContext: 'gallery' }) %>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <p>No images yet.</p>
    <% } %>
  </div>
</div>
<%- include('partials/footer') %>