PORT=3000
SESSION_SECRET=change-this-to-a-long-random-secret
# Optional admin login rate limiting override.
# LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
# LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
# Optional: bootstrap the first admin account on startup when no admin exists yet.
# INITIAL_ADMIN_USERNAME=yourname
# INITIAL_ADMIN_PASSWORD=replace-this-with-a-strong-password
# Optional SQLite database path override.
# Leave commented for local default: database/paracausal.db
# DB_PATH=database/paracausal.db